{
  "name": "oxido-language-support",
  "displayName": "Óxido Language Support",
  "description": "Language support for .ox files using the Óxido compiler frontend.",
  "version": "0.1.0",
  "publisher": "oxido-language",
  "repository": {
    "type": "git",
    "url": "https://github.com/programadorkevinsvega-sys/oxido-lengue.git",
    "directory": "editors/vscode-oxido"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:oxido"
  ],
  "extensionDependencies": [],
  "contributes": {
    "languages": [
      {
        "id": "oxido",
        "aliases": [
          "Óxido",
          "oxido"
        ],
        "extensions": [
          ".ox"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "oxido.restartLanguageServer",
        "title": "Óxido: Reiniciar servidor de lenguaje"
      },
      {
        "command": "oxido.checkCargo",
        "title": "Óxido: Comprobar con Cargo"
      },
      {
        "command": "oxido.showResourceStats",
        "title": "Óxido: Ver estadísticas del editor"
      }
    ],
    "configuration": {
      "title": "Óxido",
      "properties": {
        "oxido.serverPath": {
          "type": "string",
          "default": "oxido-lsp",
          "description": "Ruta al ejecutable oxido-lsp. Solo se usa la configuración de usuario en Restricted Mode."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "El análisis léxico y sintáctico estático funciona en modo restringido. La extensión no inicia Cargo ni rust-analyzer.",
      "restrictedConfigurations": [
        "oxido.serverPath"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:host": "node test/run-host.js",
    "test:vsix": "node test/run-host.js installed",
    "test:vsix:server": "node test/run-host.js bundled",
    "prepackage:vsix": "node scripts/prepare-package.js",
    "package:vsix": "vsce package --skip-license --out dist/oxido-language-support-0.1.0.vsix",
    "package:vsix:server": "node scripts/package-vsix-server.js",
    "checksum": "node scripts/write-sha256.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1"
  }
}
